# ─── AvixCheck environment template ───────────────────────────────────────────
# Copy to .env.local for development. In production, inject these from your
# platform's secret manager; never commit real values.
# Any integration left blank shows a "setup required" state in the app instead
# of simulated behaviour.

NODE_ENV=development
# production | staging | development | demo. Demo orgs can't be created when APP_ENV=production.
APP_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# ─── Database (required) ─── Connect as a NON-superuser role: superusers bypass row-level security.
DATABASE_URL=postgres://avix_app:avix_app@localhost:5432/avixcheck
# Optional separate owner role for migrations.
MIGRATION_DATABASE_URL=

# ─── Authentication (required) ─── "clerk" for all deployed environments.
AUTH_PROVIDER=clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Only used when AUTH_PROVIDER=dev (local development; refused in production). 32+ random chars.
SESSION_SECRET=

# ─── Private document storage (required) ─── Any S3-compatible service. Bucket must block public access.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# "true" for MinIO / most non-AWS providers.
S3_FORCE_PATH_STYLE=
SIGNED_URL_TTL_SECONDS=300

# ─── Malware scanning (required) ─── clamd reachable over TCP.
CLAMAV_HOST=
CLAMAV_PORT=3310

# ─── AI extraction (required) ───
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-5-5

# ─── Error monitoring (optional) ───
SENTRY_DSN=

# ─── Invitation email (optional; without it admins copy invite links) ───
RESEND_API_KEY=
EMAIL_FROM=

# ─── Limits ───
MAX_UPLOAD_BYTES=20971520
DEFAULT_RETENTION_DAYS=2555

# ─── Error monitoring extras (optional) ───
# Release identifier attached to Sentry events (e.g. the git SHA).
APP_RELEASE=
# 0 disables performance tracing (default). Error events are always sent when SENTRY_DSN is set.
SENTRY_TRACES_SAMPLE_RATE=0

# ─── Worker ───
# "off" disables the built-in daily scheduler (retention sweeps) on this worker instance.
WORKER_SCHEDULER=

# ─── Rate limits (optional overrides, "<limit>/<windowSeconds>") ───
# Defaults: upload 60/600, import 20/600, export 20/3600, signedUrl 300/600, invite 50/3600, inviteAccept 20/3600 (per user; invite per org).
RATE_LIMIT_UPLOAD=
RATE_LIMIT_EXPORT=
RATE_LIMIT_INVITE=

# ─── Backups (ops:backup / ops:restore-verify) ───
# Role that can read every row: the database owner (RLS is bypassed via app.bypass_rls for the dump) or a BYPASSRLS role.
BACKUP_DATABASE_URL=
BACKUP_DIR=./backups
# Separate bucket for backups, ideally in another account/region with object lock. Credentials fall back to S3_* if blank.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=avixcheck/
BACKUP_S3_REGION=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_FORCE_PATH_STYLE=
# Restore drills create and drop a scratch database here. NEVER point this at the production server's main database name.
RESTORE_ADMIN_DATABASE_URL=

# ─── Demo data (npm run db:seed-demo; refused when APP_ENV=production) ───
DEMO_OWNER_EMAIL=
